# Copy to .env and fill in. Only the three football scripts need this
# (draw_backtest.py, draw_poly_backtest.py, draw_live_scanner.py).
# Get a key at https://www.api-football.com/ (the historical seasons used here need a paid plan).
# The Polymarket scripts use public endpoints and need no credentials.
API_FOOTBALL_KEY=your_key_here
